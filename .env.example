# ---------------------------------------------------------------------------
# Veggie — environment. Copy to .env.local and fill in. Never commit .env.local.
# ---------------------------------------------------------------------------

# Database. The ONLY switch between local / Render / Cloudflare+Hyperdrive.
# Local default matches docker-compose.yml (port 5435 to avoid clashing with a
# host Postgres already on 5432-5434).
DATABASE_URL="postgresql://veggie:veggie_local_dev@localhost:5435/veggie"

# Auth.js v5. Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Object storage (S3-compatible). Local = MinIO from docker-compose.
# Later: Cloudflare R2 or AWS S3 — same client, different endpoint.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="veggie"
S3_SECRET_ACCESS_KEY="veggie_local_dev"
S3_BUCKET="veggie-uploads"

# ---------------------------------------------------------------------------
# External source adapters. All default OFF — the app has a working path
# without every one of them. See the Feature Ledger in the build plan.
# ---------------------------------------------------------------------------

# Google Places (New). Server-side only; never expose to the browser.
# Gate: billing account + attribution review (PRD 9.1, 11.3).
FEATURE_GOOGLE_PLACES="false"
GOOGLE_PLACES_API_KEY=""

# USDA FoodData Central. Free, CC0. Used by scripts/import-usda.ts, not at runtime.
USDA_FDC_API_KEY=""

# Open Food Facts barcode lookup. Free/open; requires an identifying User-Agent.
FEATURE_BARCODE_SCAN="false"
OFF_USER_AGENT="Veggie/0.1 (development@cness.co)"

# Anthropic — AI assistant (Phase 13). Server-side only.
FEATURE_AI_ASSISTANT="false"
ANTHROPIC_API_KEY=""

# Animal-impact estimates. Stays OFF until the reference factors clear legal
# review (PRD 9.8). Avoided-meal counts render regardless.
FEATURE_IMPACT_ESTIMATES="false"
